-- ==================== TOGGLES COM NOMES ORIGINAIS ====================
local Remote = ReplicatedStorage:FindFirstChild("RequestRankedReward", true)

local function createToggle(titleText, yPos, code, parent)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, 0, 0, 42)
    frame.Position = UDim2.new(0, 0, 0, yPos)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local tl = Instance.new("TextLabel", frame)
    tl.Size = UDim2.new(0.75, 0, 1, 0)
    tl.Position = UDim2.new(0, 10, 0, 0)
    tl.BackgroundTransparency = 1
    tl.Text = titleText
    tl.TextColor3 = Color3.new(1,1,1)
    tl.Font = Enum.Font.GothamBold
    tl.TextSize = 13
    tl.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0, 55, 0, 24)
    btn.Position = UDim2.new(1, -62, 0.5, -12)
    btn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    btn.Text = "OFF"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.Text = active and "ON" or "OFF"
        btn.BackgroundColor3 = active and Color3.fromRGB(50, 160, 70) or Color3.fromRGB(180, 50, 50)
        
        if active then
            task.spawn(function()
                while active and not _G.StopAllICEHUBLoops do
                    if Remote then 
                        pcall(function() Remote:InvokeServer(code) end)
                    end
                    task.wait(0.8)
                end
            end)
        end
    end)
end

