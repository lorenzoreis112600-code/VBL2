        titleLabel.TextSize = 14
        titleLabel.TextXAlignment = Enum.TextXAlignment.Left

        local subLabel = Instance.new("TextLabel", toggleFrame)
        subLabel.Size = UDim2.new(0.6, 0, 0, 16)
        subLabel.Position = UDim2.new(0, 10, 0, 24)
        subLabel.BackgroundTransparency = 1
        subLabel.TextColor3 = Color3.fromRGB(160, 160, 160)
        subLabel.Text = subtitleText
        subLabel.Font = Enum.Font.Gotham
        subLabel.TextSize = 10
        subLabel.TextXAlignment = Enum.TextXAlignment.Left

        local statusButton = Instance.new("TextButton", toggleFrame)
        statusButton.Size = UDim2.new(0, 60, 0, 24)
        statusButton.Position = UDim2.new(1, -70, 0, 9)
        statusButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        statusButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        statusButton.Text = "OFF"
        statusButton.Font = Enum.Font.GothamBold
        statusButton.TextSize = 14
        local statusCorner = Instance.new("UICorner", statusButton)
        statusCorner.CornerRadius = UDim.new(0, 4)

        local isActive = false
        local success, fail = 0, 0

        local function updateStatusText()
            statusLabel.Text = string.format("%s: %d ✓  |  %d ✗", titleText, success, fail)
        end

        local loopCoroutine
        statusButton.MouseButton1Click:Connect(function()
            isActive = not isActive
            if isActive then
                statusButton.Text = "ON"
                statusButton.BackgroundColor3 = Color3.fromRGB(50, 160, 70)
                loopCoroutine = task.spawn(function()
                    while isActive and not _G.StopAllICEHUBLoops do
                        local ok, err = pcall(function()
                            Remote:InvokeServer(code)
                        end)
                        if ok then success += 1 else fail += 1 end
                        updateStatusText()
                        task.wait(0.8)
                    end
                    if _G.StopAllICEHUBLoops then
                        isActive = false
                        statusButton.Text = "OFF"
                        statusButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
                    end
                end)
                updateStatusText()
            else
                statusButton.Text = "OFF"
                statusButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
                isActive = false
                success, fail = 0, 0
                statusLabel.Text = "Pronto para iniciar"
            end
        end)
    end

    -- Aba Farm
    createToggle("Style Spins(Bronze 2)", "Touch over either our desktop*", 0, 1, tabFarmContainer)
    createToggle("Farm Yen(Bronze 3)", "Touch over either our desktop*", 48, 2, tabFarmContainer)
    createToggle("Habilits Spins(Prata 2)", "Touch over either our desktop*", 96, 4, tabFarmContainer)

