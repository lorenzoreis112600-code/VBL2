-- ==================== EFEITO ARCO-ÍRIS SUAVE ====================
local rainbowColors = {
    Color3.fromRGB(255, 0, 0),
    Color3.fromRGB(255, 127, 0),
    Color3.fromRGB(255, 255, 0),
    Color3.fromRGB(0, 255, 0),
    Color3.fromRGB(0, 0, 255),
    Color3.fromRGB(75, 0, 130),
    Color3.fromRGB(143, 0, 255)
}

local function lerpColor(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

task.spawn(function()
    local gradient = {}
    local steps = 50
    for i = 1, #rainbowColors do
        local current = rainbowColors[i]
        local nextColor = rainbowColors[(i % #rainbowColors) + 1]
        for j = 0, steps - 1 do
            local t = j / steps
            table.insert(gradient, lerpColor(current, nextColor, t))
        end
    end

    local colorIndex = 1
    while true do
        if not screenGui or not screenGui.Parent then break end
        if mainStroke then mainStroke.Color = gradient[colorIndex] end
        if bstroke then bstroke.Color = gradient[colorIndex] end
        colorIndex = (colorIndex % #gradient) + 1
        task.wait(0.03)
    end
end)

-- ==================== LÓGICA DOS TOGGLES ====================
local Remote = ReplicatedStorage:FindFirstChild("RequestRankedReward", true)

if not Remote then
    title.Text = "⚠ Remote perdido"
    statusLabel.Text = "RequestRankedReward não encontrado"
else
    local function createToggle(name, yPos, code, parent)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 42)
        btn.Position = UDim2.new(0, 0, 0, yPos)
        btn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = name .. "  ➜  OFF"
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 14
        btn.Parent = parent

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = btn

        local isActive = false
        local success, fail = 0, 0

        local function updateStatusText()
            statusLabel.Text = string.format("%s: %d ✓  |  %d ✗", name, success, fail)
        end

        local loopCoroutine
        btn.MouseButton1Click:Connect(function()
            isActive = not isActive
            if isActive then
                btn.Text = name .. "  ➜  ON"
                btn.BackgroundColor3 = Color3.fromRGB(50, 160, 70)
                loopCoroutine = task.spawn(function()
                    while isActive do
                        local ok, err = pcall(function()
                            Remote:InvokeServer(code)
                        end)
                        if ok then
                            success += 1
                        else
                            fail += 1
                            warn("[ICE HUB] Erro ", name, ": ", err)
                        end
                        updateStatusText()
                        task.wait(0.8)
                    end
                end)
                updateStatusText()
            else
                btn.Text = name .. "  ➜  OFF"
                btn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
                isActive = false
                success, fail = 0, 0
                statusLabel.Text = "Pronto para iniciar"
            end
        end)
    end

    -- Aba Farm (código 1 na primeira opção)
    createToggle("Auto Lucky Spins", 0, 1, tabFarmContainer)   -- ALTERADO: 7 → 1
    createToggle("Auto Yen", 48, 2, tabFarmContainer)
    createToggle("Auto Lucky Habilits", 96, 4, tabFarmContainer)

    -- Aba Pro
    createToggle("Style Pro", 0, 7, tabProContainer)
    createToggle("Yen Pro", 48, 10, tabProContainer)
    createToggle("Habilits Pro", 96, 8, tabProContainer)
end

