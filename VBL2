        local toggleFrame = Instance.new("Frame", parent)
        toggleFrame.Size = UDim2.new(1, 0, 0, 42)
        toggleFrame.Position = UDim2.new(0, 0, 0, yPos)
        toggleFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
