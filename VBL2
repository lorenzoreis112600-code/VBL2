-- [[ CORES ]]
RunService.RenderStepped:Connect(function()
    local hue = 0.65 + 0.1 * math.sin(tick() * 2)
    local color = Color3.fromHSV(hue, 0.9, 1)
    
    for _, element in pairs(RainbowElements) do
        if element:IsA("UIStroke") then
            element.Color = color
        elseif element:IsA("TextLabel") then
            element.TextColor3 = color
        elseif element:IsA("TextButton") or element:IsA("Frame") then
            element.BackgroundColor3 = color
        end
    end
end)

