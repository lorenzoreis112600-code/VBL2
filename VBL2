-- ==================== TOGGLE FACTORY ====================
local Remote = ReplicatedStorage:FindFirstChild("RequestRankedReward", true)

local function createToggle(name, yPos, code, parent)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, 0, 0, 50)
    frame.Position = UDim2.new(0, 0, 0, yPos)
    frame.BackgroundColor3 = Color3.fromRGB(22, 22, 50)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local tl = Instance.new("TextLabel", frame)
    tl.Size = UDim2.new(0.65, 0, 1, 0)
    tl.Position = UDim2.new(0, 12, 0, 0)
    tl.BackgroundTransparency = 1
    tl.Text = name
    tl.TextColor3 = Color3.fromRGB(255, 255, 255)
    tl.Font = Enum.Font.GothamBold
    tl.TextSize = 12
    tl.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0, 65, 0, 30)
    btn.Position = UDim2.new(1, -75, 0.5, -15)
    btn.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
    btn.Text = "OFF"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.Text = active and "ON" or "OFF"
        btn.BackgroundColor3 = active and Color3.fromRGB(60, 180, 80) or Color3.fromRGB(120, 30, 30)
        
        if active then
            task.spawn(function()
                while active and not _G.StopAllGALAXYHUBLoops do
                    if Remote then pcall(function() Remote:InvokeServer(code) end) end
                    task.wait(0.8)
                end
            end)
        end
    end)
end

