    local Switch = Instance.new("TextButton", OptFrame)
    Switch.Size = UDim2.new(0, 44, 0, 22)
    Switch.Position = UDim2.new(1, -52, 0.5, -11)
    Switch.BackgroundColor3 = Color3.fromRGB(40, 25, 60)
    Switch.BackgroundTransparency = 0.2
    Switch.Text = ""
    Switch.AutoButtonColor = false
    Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

    local SwitchStroke = Instance.new("UIStroke", Switch)
    SwitchStroke.Thickness = 1
    SwitchStroke.Transparency = 0.3
    SwitchStroke.Color = Color3.fromRGB(200, 200, 200)

    local Knob = Instance.new("Frame", Switch)
    Knob.Size = UDim2.new(0, 18, 0, 18)
    Knob.Position = UDim2.new(0, 2, 0.5, -9)
    Knob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    Switch.MouseButton1Click:Connect(function()
        Config.Toggles[key] = not Config.Toggles[key]
        local active = Config.Toggles[key]
        
        local goalPos = active and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        TweenService:Create(Knob, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = goalPos}):Play()
        
        if active then
            table.insert(RainbowElements, Switch)
            TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(70, 40, 100)}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 255, 255)}):Play()
        else
            for i, v in ipairs(RainbowElements) do
                if v == Switch then table.remove(RainbowElements, i) break end
            end
            TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 25, 60)}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(200, 200, 200)}):Play()
        end
    end)
end

