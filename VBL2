-- ==================== EFEITO ARCO-ÍRIS SUAVE (BORDAS + TEXTO) ====================
local rainbowColors = {
    Color3.fromRGB(255, 0, 0),
    Color3.fromRGB(255, 127, 0),
    Color3.fromRGB(255, 255, 0),
    Color3.fromRGB(0, 255, 0),
    Color3.fromRGB(0, 0, 255),
    Color3.fromRGB(75, 0, 130),
    Color3.fromRGB(143, 0, 255)
}

local function lerpColor(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

task.spawn(function()
    local gradient = {}
    local steps = 50
    for i = 1, #rainbowColors do
        local current = rainbowColors[i]
        local nextColor = rainbowColors[(i % #rainbowColors) + 1]
        for j = 0, steps - 1 do
            local t = j / steps
            table.insert(gradient, lerpColor(current, nextColor, t))
        end
    end

    local colorIndex = 1
    while screenGui and screenGui.Parent and not _G.StopAllICEHUBLoops do
        local c = gradient[colorIndex]
        if mainStroke then mainStroke.Color = c end
        if bstroke then bstroke.Color = c end
        if bannerLabel then bannerLabel.TextColor3 = c end -- aplica a cor do arco-íris ao texto
        colorIndex = (colorIndex % #gradient) + 1
        task.wait(0.03)
    end
end)

-- ==================== LÓGICA DOS TOGGLES (ESTILO NOVO) ====================
local Remote = ReplicatedStorage:FindFirstChild("RequestRankedReward", true)

